# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets — never commit these
android/key.properties
android/local.properties
*.jks
*.keystore

# Firebase Admin SDK service account — never committed
*firebase-adminsdk*.json

# Ad-hoc on-device QA screenshots and asset-processing scratch output —
# real project assets always live under assets/, never loose at the repo
# root, so anything matching these at the top level is throwaway.
/*.png
/*.jpg
/*.jpeg
/screencap_err.txt
.asset_backup_*/
