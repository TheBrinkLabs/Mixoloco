<?xml version="1.0" encoding="utf-8"?>
<!-- inset manually tuned down from flutter_launcher_icons' 16% default —
     6% first (too bold, clipped on-device per feedback), now 9% (~7%
     smaller than the 6% version, still much bolder than the 16%
     default) — re-running flutter_launcher_icons resets this back to
     16%, re-apply 9% after any future regeneration. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="9%" />
  </foreground>
</adaptive-icon>
